{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/attestation.v2.schema.json",
  "title": "ReviewedProof Attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "completed_at", "expires_at", "identity_assurance", "manifest_digest", "organisation_authority", "package_root", "receipt_id", "review_id", "reviewer", "schema_version", "statement"],
  "properties": {
    "schema_version": {"const": "rproof.attestation.v2"},
    "attestation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "receipt_id": {"type": "string", "minLength": 12, "maxLength": 128},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "completed_at": {"$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"},
    "expires_at": {
      "oneOf": [
        {"$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"},
        {"type": "null"}
      ]
    },
    "package_root": {"$ref": "common.v1.schema.json#/$defs/packageRootDigest"},
    "manifest_digest": {"$ref": "common.v1.schema.json#/$defs/sha256Digest"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "subject_id"],
      "properties": {
        "display_name": {"type": ["string", "null"], "maxLength": 200},
        "subject_id": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "identity_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessed_at", "level", "methods", "policy_version", "provider", "provider_reference"],
      "properties": {
        "assessed_at": {"$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"},
        "level": {"enum": ["A0", "A1", "A2", "A3"]},
        "methods": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}, "uniqueItems": true},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "provider": {"type": "string", "minLength": 1, "maxLength": 100},
        "provider_reference": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "organisation_authority": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_type", "grant_digest", "organisation_id", "valid_at_attestation"],
          "properties": {
            "authority_type": {"type": "string", "minLength": 1, "maxLength": 100},
            "grant_digest": {"$ref": "common.v1.schema.json#/$defs/sha256Hex"},
            "organisation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "valid_at_attestation": {"const": true}
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment", "declarations", "exact_text", "purpose", "scope", "statement_type", "template_hash", "template_id", "template_version"],
      "properties": {
        "comment": {"type": ["string", "null"], "maxLength": 2000},
        "declarations": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
        "exact_text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
        "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
        "statement_type": {"enum": ["reviewed", "reviewed_and_approved", "independently_verified", "custom"]},
        "template_hash": {"$ref": "common.v1.schema.json#/$defs/sha256Hex"},
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "template_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}

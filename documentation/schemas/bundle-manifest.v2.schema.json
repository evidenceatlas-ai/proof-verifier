{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/bundle-manifest.v2.schema.json",
  "title": "ReviewedProof Evidence Bundle Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "components", "created_at", "receipt_id", "schema_version"],
  "properties": {
    "schema_version": {"const": "rproof.bundle-manifest.v2"},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "receipt_id": {"type": "string", "minLength": 12, "maxLength": 128},
    "created_at": {"$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_length", "media_type", "path", "sha256"],
        "properties": {
          "path": {"$ref": "common.v1.schema.json#/$defs/safeRelativePath"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
          "byte_length": {"type": "integer", "minimum": 0, "maximum": 10485760},
          "sha256": {"$ref": "common.v1.schema.json#/$defs/sha256Hex"}
        }
      }
    }
  }
}

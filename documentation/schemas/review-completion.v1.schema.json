{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/review-completion.v1.schema.json",
  "title": "ReviewedProof Review Completion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion_id", "policy_snapshot", "receipt_id", "receipt_links", "review_id", "satisfied_at", "schema_version"],
  "properties": {
    "schema_version": {"const": "rproof.review-completion.v1"},
    "completion_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "receipt_id": {"type": "string", "minLength": 12, "maxLength": 128},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "satisfied_at": {"$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"},
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_reviewers", "required_roles", "threshold", "type"],
      "properties": {
        "type": {"enum": ["all_required", "threshold", "role_quorum", "any_reviewer"]},
        "eligible_reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assignment_id", "required", "role_code"],
            "properties": {
              "assignment_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "required": {"type": "boolean"},
              "role_code": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "common.v1.schema.json#/$defs/reasonCode"}
                ]
              }
            }
          }
        },
        "threshold": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 100}
          ]
        },
        "required_roles": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "common.v1.schema.json#/$defs/reasonCode"},
          "uniqueItems": true
        }
      }
    },
    "receipt_links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignment_id", "attestation_id", "receipt_id", "role_code"],
        "properties": {
          "assignment_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "attestation_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "receipt_id": {"type": "string", "minLength": 12, "maxLength": 128},
          "role_code": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "common.v1.schema.json#/$defs/reasonCode"}
            ]
          }
        }
      }
    }
  }
}

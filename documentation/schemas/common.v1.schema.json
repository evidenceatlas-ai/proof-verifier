{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/common.v1.schema.json",
  "title": "ReviewedProof Common Contract Definitions v1",
  "$defs": {
    "artefactMatchCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "state"],
      "properties": {
        "reason_code": {"$ref": "#/$defs/reasonCode"},
        "state": {"enum": ["valid", "invalid", "not_checked"]}
      }
    },
    "evidenceEnvironment": {
      "enum": ["production", "staging", "development"]
    },
    "exactUtcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "packageRootDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "rproof-rfc6962-sha256-v1"},
        "value": {"$ref": "#/$defs/sha256Hex"}
      }
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000/]+(?:/[^\\u0000/]+)*$",
      "minLength": 1,
      "maxLength": 512
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha-256"},
        "value": {"$ref": "#/$defs/sha256Hex"}
      }
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "state"],
      "properties": {
        "reason_code": {"$ref": "#/$defs/reasonCode"},
        "state": {
          "enum": ["valid", "invalid", "not_present", "not_checked", "unsupported"]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/timestamp-evidence.v1.schema.json",
  "title": "ReviewedProof RFC 3161 Timestamp Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "certificate_chain",
    "message_imprint_sha256",
    "nonce_sha256",
    "policy_oid",
    "provider",
    "schema_version",
    "token",
    "token_gen_time"
  ],
  "properties": {
    "schema_version": {"const": "rproof.timestamp-evidence.v1"},
    "algorithm": {"const": "rfc3161-sha256"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_oid": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^(?:(?:0|1)\\.(?:0|[1-9]|[1-3][0-9])|2\\.(?:0|[1-9][0-9]*))(?:\\.(?:0|[1-9][0-9]*))*$"
    },
    "message_imprint_sha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256Hex"
    },
    "nonce_sha256": {"$ref": "common.v1.schema.json#/$defs/sha256Hex", "description": "SHA-256 of the positive RFC 3161 nonce encoded as minimal unsigned big-endian bytes without leading zero bytes; excludes DER type, length and sign padding."},
    "token_gen_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "token": {"$ref": "#/$defs/timestampTokenDescriptor"},
    "certificate_chain": {"$ref": "#/$defs/certificateChainDescriptor"}
  },
  "$defs": {
    "timestampTokenDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "media_type", "path", "sha256"],
      "properties": {
        "path": {"const": "evidence/timestamp/attestation.tsr"},
        "media_type": {"const": "application/timestamp-reply"},
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {"$ref": "common.v1.schema.json#/$defs/sha256Hex"}
      }
    },
    "certificateChainDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "media_type", "path", "sha256"],
      "properties": {
        "path": {"const": "evidence/timestamp/tsa-chain.pem"},
        "media_type": {"const": "application/pem-certificate-chain"},
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {"$ref": "common.v1.schema.json#/$defs/sha256Hex"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reviewedproof.com/schemas/trust-store.v1.schema.json",
  "title": "ReviewedProof Offline Verifier Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "reviewedproof_roots",
    "schema_version",
    "trust_store_version",
    "tsa_policies"
  ],
  "properties": {
    "schema_version": {
      "const": "rproof.trust-store.v1"
    },
    "trust_store_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "environment": {
      "$ref": "common.v1.schema.json#/$defs/evidenceEnvironment"
    },
    "reviewedproof_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rootEntry"
      }
    },
    "tsa_policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tsaPolicy"
      }
    }
  },
  "$defs": {
    "rootEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_sha256",
        "jwk",
        "kid",
        "not_after",
        "not_before",
        "status",
        "operational_key_distrust_events"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "jwk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crv",
            "kty",
            "x",
            "y"
          ],
          "properties": {
            "crv": {
              "const": "P-256"
            },
            "kty": {
              "const": "EC"
            },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "y": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "fingerprint_sha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256Hex"
        },
        "not_before": {
          "$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"
        },
        "not_after": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1.schema.json#/$defs/exactUtcDateTime"
            }
          ]
        },
        "status": {
          "enum": [
            "trusted",
            "retired",
            "distrusted"
          ]
        },
        "operational_key_distrust_events": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "jws"
            ],
            "properties": {
              "event": {
                "$ref": "key-distrust-event.v1.schema.json"
              },
              "jws": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              }
            }
          }
        }
      }
    },
    "tsaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_roots_pem",
        "policy_oids",
        "tsa_id"
      ],
      "properties": {
        "tsa_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_oids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:(?:0|1)\\.(?:0|[1-9]|[1-3][0-9])|2\\.(?:0|[1-9][0-9]*))(?:\\.(?:0|[1-9][0-9]*))*$",
            "minLength": 3,
            "maxLength": 128
          }
        },
        "certificate_roots_pem": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        }
      }
    }
  }
}

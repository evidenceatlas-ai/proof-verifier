{
  "name": "reviewedproof-proof-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.7.0",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "build:schemas": "node scripts/build_verifier_schemas.mjs",
